#
# Laravel .gitignore
#

/node_modules
/public/build
/public/hot
/storage/*.key
/storage/debugbar
/storage/framework/*
/storage/logs/*
/storage/pail
/vendor

# Environment & configuration
.env
.env.backup
.env.production
.env.*
!.env.example

# IDE / Editor
.idea
.vscode
.fleet
.nova
.zed
.DS_Store
Thumbs.db

# NPM
npm-debug.log
yarn-debug.log
yarn-error.log

# PHPUnit
.phpunit.result.cache
/phpunit.xml
.coverage
/coverage

# Temporary files
*.tmp
*.temp
*.log

# OS generated files
Icon?
Ehthumbs.db
Desktop.ini
._*
.Spotlight-V100
.Trashes

# Credentials
auth.json
.passwords

# Debug bar storage
/storage/*.bar